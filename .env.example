# Supabase (local: `supabase status` muestra estos valores)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Secreto compartido entre pg_cron y /api/worker (mín. 16 caracteres)
WORKER_SECRET=

# Fuentes de datos
DENUE_TOKEN=            # https://www.inegi.org.mx/app/api/denue/v1/tokenVerify.aspx
GOOGLE_PLACES_API_KEY=  # Places API (New)
PAGESPEED_API_KEY=

# IA (solo servidor; opcional hasta activar los borradores)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
