# Supabase (local: `supabase status` muestra estos valores)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto compartido entre pg_cron y /api/worker (mín. 16 caracteres)
WORKER_SECRET=

# Fuentes de datos
DENUE_TOKEN=            # https://www.inegi.org.mx/app/api/denue/v1/tokenVerify.aspx
GOOGLE_PLACES_API_KEY=  # Places API (New)
PAGESPEED_API_KEY=

# Vercel AI Gateway (solo servidor; opcional hasta activar los borradores)
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.5
AI_FALLBACK_MODELS=anthropic/claude-sonnet-4.6,google/gemini-3-flash
